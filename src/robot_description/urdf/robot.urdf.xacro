<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="marek_robot_clean">

  <!-- ======================================================= -->
  <!-- CZYSTY MODEL KINEMATYCZNY - 2026-08-17                 -->
  <!--                                                        -->
  <!-- Dane z fizycznych pomiarow:                            -->
  <!-- J1->J2 = 155 mm                                        -->
  <!-- J2->J3 = 295 mm                                        -->
  <!-- J3->J4 = 150 mm + 10 mm offset wzdluz osi X           -->
  <!-- J4->J5 = 115 mm                                        -->
  <!-- J5->TCP = 140 mm                                       -->
  <!--                                                        -->
  <!-- Zera z pozycji fizycznie pionowej:                     -->
  <!-- J2 = 1.502451582768484                                 -->
  <!-- J3 = 2.2172394305143346                                -->
  <!-- J4 = 1.6580627893946132                                -->
  <!--                                                        -->
  <!-- KRYTYCZNE:                                             -->
  <!-- znak J1 zweryfikowany przez TF base_link->tool0.        -->
  <!-- Model i FK uzywaja axis +Z / yaw = +q1.                -->
  <!-- ======================================================= -->

  <link name="base_link"/>
  <link name="link_1"/>
  <link name="link_2"/>
  <link name="link_3"/>
  <link name="link_4"/>
  <link name="link_5"/>
  <link name="tool0"/>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-5.87425" upper="0.0" effort="100" velocity="1.0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.155" rpy="-1.502451582768484 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="3.81371" effort="100" velocity="1.0"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.295" rpy="-2.2172394305143346 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="4.46884" effort="100" velocity="1.0"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.010 0 0.150" rpy="-1.6580627893946132 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0872664626" upper="3.1415926536" effort="50" velocity="1.5"/>
  </joint>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0.115" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="3.1415926536" effort="30" velocity="2.0"/>
  </joint>

  <joint name="tool0_joint" type="fixed">
    <parent link="link_5"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.140" rpy="0 0 0"/>
  </joint>

  <!-- ROS2 CONTROL - ten sam fizyczny hardware co dotychczas -->
  <ros2_control name="ManipulatorSystem" type="system">
    <hardware>
      <plugin>robot_hardware/ArduinoSystem</plugin>
      <param name="serial_port">/dev/ttyUSB0</param>
      <param name="baud_rate">115200</param>
    </hardware>

    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="joint_4">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="joint_5">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

</robot>
